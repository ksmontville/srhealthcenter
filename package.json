{
  "name": "srhealthcenter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,html,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "netlify-cli": "^27.0.1",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "sass": "^1.102.0",
    "vite": "^8.2.0",
    "vite-plugin-vuetify": "^2.1.3"
  }
}
